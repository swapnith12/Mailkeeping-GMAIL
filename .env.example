# From Google Cloud Console > APIs & Services > Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Generate with: npx auth secret
AUTH_SECRET=

# Not needed on Vercel's own *.vercel.app domain in production — Auth.js
# auto-detects the host there (it trusts Vercel's proxy by default).
# Set this if you're serving from a custom domain, so it's explicit rather
# than relying on inference: https://your-custom-domain.com
# Also not needed for local dev (auto-detects http://localhost:3000).
# AUTH_URL=https://your-custom-domain.com

# From https://aistudio.google.com/app/apikey — used to classify emails
GEMINI_API_KEY=

# Upstash Redis — used for the free-tier scan quota, subscription status,
# and the scan-result cache. From the Upstash console: your database >
# "REST API" section (NOT the redis:// / TLS connection string shown
# elsewhere on that page — this app uses the REST client, which is what
# works well from Vercel's serverless functions without a persistent TCP
# connection). Upstash's free tier is persistent (not a volatile cache) —
# this matters here since lib/subscription.ts stores paid status in it too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# From the Stripe Dashboard (Developers > API keys) — use a test-mode
# secret key (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=

# The Price ID (price_...) for the Pro subscription — Stripe Dashboard >
# Product catalog > your product > pricing.
STRIPE_PRICE_ID=

# Signing secret for the webhook endpoint (whsec_...). In local dev, run
# `stripe listen --forward-to localhost:3000/api/billing/webhook` — the
# Stripe CLI prints this value. In production, get it from the Dashboard's
# webhook endpoint settings instead (Developers > Webhooks > your Vercel
# deployment's URL + /api/billing/webhook) — this is a *different* secret
# from the local one.
STRIPE_WEBHOOK_SECRET=
